<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="150dp"
    android:layout_height="wrap_content"
    android:background="#4CFFFFFF"
    android:orientation="vertical"
    tools:ignore="Overdraw,SmallSp">

    <View style="@style/WatermarkBorder" />

    <ImageView
        android:id="@+id/logoImageView"
        android:layout_width="92dp"
        android:layout_height="24dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:scaleType="centerCrop"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/serviceTypeTextView"
        style="@style/WatermarkText"
        android:layout_marginStart="10dp"
        android:layout_marginTop="8dp"
        android:background="#2C86FF"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:textColor="@android:color/white" />

    <LinearLayout style="@style/WatermarkRow">
        <LinearLayout
            android:id="@+id/insuredPersonField"
            style="@style/WatermarkPersonField"
            android:layout_marginEnd="4dp">
            <TextView style="@style/WatermarkText" android:text="@string/watermark_insured_person_label" />
            <TextView android:id="@+id/insuredPersonTextView" style="@style/WatermarkValue" />
        </LinearLayout>
        <LinearLayout style="@style/WatermarkPersonField">
            <TextView style="@style/WatermarkText" android:text="@string/watermark_caregiver_label" />
            <TextView android:id="@+id/caregiverTextView" style="@style/WatermarkValue" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout style="@style/WatermarkRow">
        <TextView
            android:id="@+id/captureTimeLabelTextView"
            style="@style/WatermarkText"
            android:text="@string/watermark_capture_time_label" />
        <TextView
            android:id="@+id/captureTimeTextView"
            style="@style/WatermarkValue" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/addressRow"
        style="@style/WatermarkRow">
        <TextView
            style="@style/WatermarkText"
            android:text="@string/watermark_capture_location_label" />
        <TextView
            android:id="@+id/captureLocationTextView"
            style="@style/WatermarkValue" />
    </LinearLayout>

    <LinearLayout style="@style/WatermarkRow">
        <TextView
            android:id="@+id/coordinatesLabelTextView"
            style="@style/WatermarkText"
            android:text="@string/watermark_coordinates_label" />
        <TextView
            android:id="@+id/coordinatesTextView"
            style="@style/WatermarkValue" />
    </LinearLayout>

    <View
        style="@style/WatermarkBorder"
        android:layout_marginTop="8dp" />
</LinearLayout>
